# CEASAR ENTERPRISE Manager - example configuration
#
# Copy to .env and adjust, or just export these in your shell before starting.
# The app needs NO configuration to run: every value below has a safe default.

# HTTP port for the dashboard.
PORT=3002

# Signs session tokens. Set this to a long random string so logins survive a
# restart. If unset, a random key is generated at every boot and every session
# is invalidated whenever the server restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the JSON data files live. Defaults to ./data inside the project.
# Point it elsewhere to run several farms or keep data outside the repo.
CEM_DATA_DIR=

# Local OpenAI-compatible LLM for the assistant panel (Ollama works).
# Leave blank to use http://localhost:11434 . The panel reports
# "AI unavailable" when nothing is listening - the rest of the app is unaffected.
AI_ENDPOINT=
